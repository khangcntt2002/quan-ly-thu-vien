extends ../layout

block content
  h2 Sách tôi đã mượn
  
  if borrows.length === 0
    p Chưa mượn cuốn sách nào.
  else
    table
      thead
        tr
          th Tên sách
          th Ngày mượn
          th Hẹn trả
          th Trạng thái
          th Hành động
      tbody
        each borrow in borrows
          tr
            td= borrow.book.title
            td= borrow.borrowDate.toLocaleDateString('vi-VN')
            td= borrow.dueDate.toLocaleDateString('vi-VN')
            td
              if borrow.status === 'borrowing'
                span.status--mượn Đang mượn
              else
                span.status--trả Đã trả
            td
              if borrow.status === 'borrowing'
                form(action=`/borrow/${borrow._id}/return` method='post')
                  button(type='submit') Trả sách
