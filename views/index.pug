                article.home-benefit
                    span.home-benefit-icon 💬
                    h3 Hỗ trợ tận tình
                    p Luôn sẵn sàng hỗ trợ bạn trong quá trình sử dụng.

        section.home-section(aria-labelledby="home-featured-title")
