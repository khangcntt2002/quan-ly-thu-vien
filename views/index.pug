                        img(src="/images/library-banner.jpg" alt="Không gian thư viện Nhà Sách Phúc Khang")
                    if featuredBooks && featuredBooks.filter(book => book.image).length
                        each book in featuredBooks.filter(book => book.image).slice(0, 4)
                            .carousel-item
                                img(src=book.image alt=`Sách nổi bật: ${book.title}`)
                button.carousel-control-prev(type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="prev" aria-label="Ảnh trước")
