block content
    style.
        body {
            margin: 0;
            font-family: Arial, sans-serif;
        }

        .library-home {
            width: 100%;
            min-height: 585px;
            box-sizing: border-box;
            padding: 57px 20px 55px;
            text-align: center;
            background: linear-gradient(
                110deg,
                #99512d 0%,
                #ae602e 48%,
                #d1873d 100%
            );
        }

        .library-home-container {
            max-width: 1035px;
            margin: 0 auto;
        }

        .library-home-image {
            width: 100%;
            height: 337px;
            object-fit: cover;
            object-position: center;
            display: block;
            border-radius: 13px;
        }

        .library-home-title {
            font-size: 32px;
            font-weight: 400;
            color: #211a17;
            margin-top: 18px;
            margin-bottom: 14px;
            line-height: 1.4;
        }

        .library-home-subtitle {
            color: #493020;
            font-size: 16px;
            margin-bottom: 15px;
        }

        .library-home-description {
            color: #513625;
            font-size: 13px;
            margin: 0 0 30px;
        }

        /* === THANH TÌM KIẾM === */
        .search-box {
            max-width: 600px;
            margin: 0 auto;
        }
        .search-input {
            width: 100%;
            padding: 14px 25px;
            border: none;
            border-radius: 50px;
            font-size: 16px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
            outline: none;
        }
        .search-btn {
            margin-top: 12px;
            padding: 12px 35px;
            background: #211a17;
            color: white;
            border: none;
            border-radius: 50px;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s;
        }
        .search-btn:hover {
            background: #493020;
            transform: scale(1.05);
        }

        /* === TÍNH NĂNG NỔI BẬT === */
        .features-section {
            padding: 60px 20px;
            background: #fff9f2;
        }
        .features-container {
            max-width: 1200px;
            margin: 0 auto;
        }
        .features-title {
            text-align: center;
            font-size: 28px;
            color: #513625;
            margin-bottom: 40px;
        }
        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
        }
        .feature-card {
            background: white;
            padding: 30px 20px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 4px 12px rgba(153, 81, 45, 0.1);
            transition: all 0.3s ease;
        }
        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 8px 25px rgba(153, 81, 45, 0.2);
        }
        .feature-icon {
            font-size: 45px;
            margin-bottom: 15px;
        }
        .feature-card h4 {
            color: #99512d;
            margin-bottom: 10px;
            font-size: 18px;
        }
        .feature-card p {
            color: #7a5d4c;
            font-size: 14px;
            margin: 0;
        }

        /* === SÁCH NỔI BẬT === */
        .books-section {
            padding: 60px 20px;
            background: white;
        }
        .books-container {
            max-width: 1200px;
            margin: 0 auto;
        }
        .books-title {
            text-align: center;
            font-size: 28px;
            color: #513625;
            margin-bottom: 40px;
        }
        .books-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 30px;
        }
        .book-card {
            background: #fff9f2;
            border-radius: 12px;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        .book-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 25px rgba(153, 81, 45, 0.15);
        }
        .book-img {
            width: 100%;
            height: 260px;
            object-fit: cover;
            background: #e8d5c4;
        }
        .book-info {
            padding: 18px;
            text-align: center;
        }
        .book-name {
            font-weight: bold;
            color: #513625;
            margin-bottom: 5px;
            font-size: 15px;
        }
        .book-author {
            color: #997c68;
            font-size: 13px;
            margin-bottom: 12px;
        }
        .book-link {
            display: inline-block;
            padding: 8px 20px;
            background: #99512d;
            color: white;
            border-radius: 20px;
            text-decoration: none;
            font-size: 14px;
            transition: 0.3s;
        }
        .book-link:hover {
            background: #ae602e;
            color: white;
            text-decoration: none;
        }

        /* === NÚT KÊU GỌI HÀNH ĐỘNG === */
        .cta-section {
            padding: 50px 20px 70px;
            text-align: center;
            background: linear-gradient(120deg, #99512d, #d1873d);
            color: white;
        }
        .cta-title {
            font-size: 26px;
            margin-bottom: 15px;
        }
        .cta-desc {
            font-size: 16px;
            margin-bottom: 30px;
            opacity: 0.9;
        }
        .cta-btn {
            display: inline-block;
            padding: 14px 35px;
            margin: 8px;
            border-radius: 50px;
            font-size: 16px;
            text-decoration: none;
            transition: 0.3s;
        }
        .cta-btn-primary {
            background: white;
            color: #99512d;
            font-weight: bold;
        }
        .cta-btn-primary:hover {
            transform: scale(1.05);
            color: #99512d;
        }
        .cta-btn-outline {
            border: 2px solid white;
            color: white;
        }
        .cta-btn-outline:hover {
            background: white;
            color: #99512d;
        }

        /* === HIỆU ỨNG HIỆN DẦN === */
        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            animation: fadeUp 0.8s forwards;
        }
        @keyframes fadeUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .delay-1 { animation-delay: 0.1s; }
        .delay-2 { animation-delay: 0.2s; }
        .delay-3 { animation-delay: 0.3s; }
        .delay-4 { animation-delay: 0.4s; }

        @media (max-width: 768px) {
            .library-home {
                padding: 35px 15px;
                min-height: auto;
            }
            .library-home-image {
                height: 230px;
            }
            .library-home-title {
                font-size: 24px;
            }
            .features-title, .books-title {
                font-size: 22px;
            }
            .cta-title {
                font-size: 20px;
            }
        }

    .library-home
        .library-home-container
            img.library-home-image(
                src="/images/library-banner.jpg"
                alt="Thư viện sách Phúc Khang"
            )

            

            
            p.library-home-description
                | Chúc bạn có những giờ học tập, đọc sách thật vui và tạo được nhiều sản phẩm thú vị!

            // === THANH TÌM KIẾM ===
            form.search-box(action="/books", method="GET")
                input.search-input(type="text", name="search", placeholder="🔍 Tìm tên sách, tác giả, thể loại..." required)
                button.search-btn(type="submit") Tìm kiếm sách

    // === TÍNH NĂNG NỔI BẬT ===
    section.features-section
        .features-container
            h2.features-title.fade-in Tại sao chọn Thư viện Phúc Khang?
            .features-grid
