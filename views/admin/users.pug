extends ../layout

block content
    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-3
        div
            p.text-primary.fw-semibold.mb-1 KHU VỰC QUẢN TRỊ
            h1.h3.mb-1 Quản lý tài khoản
            p.text-secondary.mb-0 Xem, quản lý và xóa tài khoản người dùng.
        a.btn.btn-outline-secondary(href='/admin') Quay lại Admin

    if query && query.deleted === '1'
        .alert.alert-success Tài khoản đã được xóa thành công.
    if query && query.error === 'self'
        .alert.alert-warning Bạn không thể tự xóa tài khoản đang đăng nhập.
    if query && query.error === 'admin'
        .alert.alert-warning Không thể xóa tài khoản quản trị viên.
    if query && query.error === 'active'
        .alert.alert-warning Người dùng vẫn còn sách chưa trả. Hãy xử lý lượt mượn trước khi xóa.
    if query && query.error === 'notfound'
        .alert.alert-warning Tài khoản không tồn tại hoặc đã được xóa.
    if query && query.error === 'invalid'
        .alert.alert-warning Mã tài khoản không hợp lệ.

    .card.admin-panel-card
        .card-body.p-3.p-md-4
            .table-responsive
                table.table.table-hover.align-middle.mb-0
                    thead
                        tr
                            th Họ tên
                            th Email
                            th Vai trò
                            th Ngày tạo
                            th.text-end Thao tác
                    tbody
                        if users && users.length
                            each account in users
                                tr
                                    td.fw-semibold= account.name
                                    td= account.email
                                    td
                                        span.badge(class=account.role === 'admin' ? 'text-bg-success' : 'text-bg-secondary')= account.role
                                    td= account.createdAt ? new Date(account.createdAt).toLocaleDateString('vi-VN') : ''
                                    td.text-end
                                        if account.role !== 'admin'
                                            form.d-inline(method='POST', action='/admin/users/' + account._id + '/delete', onsubmit="return confirm('Bạn có chắc muốn xóa tài khoản này? Lịch sử mượn của tài khoản cũng sẽ bị xóa.');")
                                                button.btn.btn-sm.btn-outline-danger(type='submit')
                                                    i.bi.bi-trash.me-1
                                                    | Xóa user
                                        else
                                            span.text-secondary.small Không thể xóa Admin
                        else
                            tr
                                td(colspan='5').text-center.py-4 Chưa có tài khoản.
