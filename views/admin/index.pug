extends ../layout

block content
    - const summary = stats || {}
    .py-3
        p.text-primary.fw-semibold.mb-2 KHU VỰC QUẢN TRỊ
        h1.h2.mb-2 Bảng điều khiển Admin
        p.text-secondary Xin chào #{user.name}. Đây là khu vực quản lý hệ thống thư viện.

        .row.g-3.my-4
            .col-6.col-lg-3
                .card.admin-stat-card.h-100
                    .card-body.p-3
                        p.mb-2 📚 Tổng số sách
                        h2.h3.mb-0= summary.books || 0
            .col-6.col-lg-3
                .card.admin-stat-card.h-100
                    .card-body.p-3
                        p.mb-2 👥 Tài khoản
                        h2.h3.mb-0= summary.users || 0
            .col-6.col-lg-3
                .card.admin-stat-card.h-100
                    .card-body.p-3
                        p.mb-2 📝 Tổng lượt mượn
                        h2.h3.mb-0= summary.borrows || 0
            .col-6.col-lg-3
                .card.admin-stat-card.h-100
                    .card-body.p-3
                        p.mb-2 📖 Đang mượn
                        h2.h3.mb-0= summary.activeBorrows || 0
        .card.admin-revenue-card.mb-4
            .card-body.p-4
                p.mb-1.opacity-75 Tổng tiền thanh toán trong tháng này
                h2.h3.mb-0= (summary.monthlyRevenue || 0).toLocaleString('vi-VN') + ' ₫'
                small.opacity-75 Tính từ các lượt mượn đã thanh toán; chưa bao gồm khoản chi vận hành.

        h2.h5.mb-3 Chức năng quản trị
        .row.g-3
            .col-sm-6.col-lg-4
                a.card.admin-action-card.text-decoration-none.h-100(href='/book/add')
                    .card-body.p-4
                        .fs-2.mb-2 📕
                        h3.h5 Thêm sách
                        p.mb-0 Thêm sách mới vào thư viện.
            .col-sm-6.col-lg-4
                a.card.admin-action-card.text-decoration-none.h-100(href='/book')
                    .card-body.p-4
                        .fs-2.mb-2 📚
                        h3.h5 Quản lý sách
                        p.mb-0 Xem, chỉnh sửa và xóa sách.
            .col-sm-6.col-lg-4
                a.card.admin-action-card.text-decoration-none.h-100(href='/admin/users')
                    .card-body.p-4
                        .fs-2.mb-2 👥
                        h3.h5 Quản lý tài khoản
                        p.mb-0 Xem và xóa tài khoản User.
            .col-sm-6.col-lg-4
                a.card.admin-action-card.text-decoration-none.h-100(href='/borrow/all')
                    .card-body.p-4
                        .fs-2.mb-2 🔄
                        h3.h5 Quản lý mượn/trả
                        p.mb-0 Theo dõi các lượt mượn và trả sách.
            .col-sm-6.col-lg-4
                a.card.admin-action-card.text-decoration-none.h-100(href='/admin/orders')
                    .card-body.p-4
                        .fs-2.mb-2 🛒
                        h3.h5 Quản lý đơn hàng
                        p.mb-0 Xem đơn mua sách và cập nhật trạng thái.
            .col-sm-6.col-lg-4
                a.card.admin-action-card.text-decoration-none.h-100(href='/admin/thu-chi')
                    .card-body.p-4
                        .fs-2.mb-2 💰
                        h3.h5 Quản lý thu chi
                        p.mb-0 Xem doanh thu, chi phí và lợi nhuận theo tháng.
