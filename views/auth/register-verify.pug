extends ../layout

block content
    - const formError = typeof error !== 'undefined' ? error : null
    - const values = typeof old !== 'undefined' && old ? old : {}
    .row.justify-content-center.py-3.py-md-4
        .col-md-8.col-lg-6
            .card.border-0.shadow-sm.rounded-4
                .card-body.p-4.p-md-5
                    h1.h3.mb-2 Xác thực đăng ký
                    p.text-secondary.mb-4 Nhập mã OTP và đặt mật khẩu mới cho tài khoản của bạn.
                    if formError
                        .alert.alert-danger(role="alert")= formError
                    form(method="POST" action="/register/verify")
                        input(type="hidden" name="email" value=values.email)
                        
                        .mb-3
                            label.form-label Mã OTP (6 chữ số)
                            input.form-control(type="text" name="otp" maxlength="6" placeholder="123456" required)
                        
                        .mb-3
                            label.form-label Mật khẩu mới (từ 8 ký tự)
                            input.form-control(type="password" name="password" required)
                        
                        .mb-4
                            label.form-label Nhập lại mật khẩu
                            input.form-control(type="password" name="confirm" required)
                        
                        button.btn.btn-primary.w-100(type="submit") Hoàn tất đăng ký
                    
                    // === ✅ 2 link trong 1 khung — ở ngay dưới nút Hoàn tất đăng ký ===
                    .mt-3.p-3.border.rounded.bg-light.text-center
                        a(href="/login") Quay lại đăng nhập
                        span.text-muted.mx-2 |
                        a(href="/register") Quay lại đăng ký
