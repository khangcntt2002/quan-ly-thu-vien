extends layout

block style
    // CSS đã thêm ở trên rồi

block content
    .book-detail-container
        // Đường dẫn điều hướng
        .breadcrumb
            a(href="/") Trang chủ
            span › 
            a(href="/book") Sách
            span › #{book.title}

        // Khung chính
        .book-detail-card
            .book-detail-inner
                // Bìa sách
                .book-detail-cover
                    img(src=book.image || '/images/default-book.jpg', alt=book.title)

                // Thông tin sách
                .book-detail-info
                    h1.book-detail-title= book.title

                    dl.book-detail-meta
                        dt Tác giả
                        dd= book.author
                        
                        dt Thể loại
                        dd= book.category
                        
                        dt Phiên bản
                        dd= book.edition || 'Chưa cập nhật'
                        
                        dt Danh mục
                        dd= book.menuCategory || 'Chưa phân loại'

                    h3 Giới thiệu sách
                    .book-detail-desc
                        p= book.description || 'Đang cập nhật nội dung...'

                    // Nút hành động
                    .book-detail-actions
                        if user
                            // === Đã đăng nhập → hiện form MƯỢN sách ===
                            form(action="/borrow/book" method="post")
                                input(type="hidden" name="bookId" value=book._id)
                                .mb-2
                                    label.form-label Hẹn trả trước:
                                    input(type="date" name="dueDate" required)
                                button(type="submit").btn-muon-sach
                                    i.bi.bi-book-plus.me-1
                                    | Mượn sách

                            // Kiểm tra nếu đang mượn thì hiện nút TRẢ
                            if isBorrowing
                                form(action=`/borrow/${activeBorrowId}/return` method="post")
                                    button(type="submit").btn-tra-sach
                                        i.bi.bi-arrow-return-left.me-1
                                        | Trả sách
                        else
                            // Chưa đăng nhập → mời đăng nhập
                            p Vui lòng 
                                a(href="/login") đăng nhập 
                                | để mượn sách

                        // Luôn hiện nút Danh sách
                        a.btn-danh-sach(href="/book")
                            i.bi.bi-arrow-left.me-1
                            | Danh sách sách
