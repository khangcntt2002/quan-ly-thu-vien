                        dd= book.author
                        
                        dt Thể loại
                        dd= book.category
                        
                        dt Phiên bản
                        dd= book.edition || 'Chưa cập nhật'
                        
                        dt Danh mục
                        dd= book.menuCategory || 'Chưa phân loại'

