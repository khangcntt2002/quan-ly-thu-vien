extends layout

block content
  .container.py-4
    .row.justify-content-center
      .col-lg-9
        h1.mb-3 Hướng dẫn mượn sách
        p.text-secondary Làm theo các bước dưới đây để mượn sách tại Nhà Sách Phúc Khang.
        .card.shadow-sm
          .card-body.p-4
            ol.mb-0
              li.mb-3 Đăng nhập tài khoản của bạn. Nếu chưa có tài khoản, hãy chọn Đăng ký.
              li.mb-3 Mở mục Sách và chọn cuốn sách muốn mượn để xem thông tin chi tiết.
              li.mb-3 Tại trang chi tiết, chọn ngày hẹn trả.
              li.mb-3 Nhấn nút Mượn sách để gửi yêu cầu.
              li.mb-3 Vào mục Sách tôi đã mượn để theo dõi trạng thái và hạn trả.
            .alert.alert-info.mt-4.mb-0 Lưu ý: Bạn cần đăng nhập mới có thể mượn sách. Nếu sách đang được người khác mượn, hệ thống sẽ thông báo.
        .mt-3
          a.btn.btn-primary(href='/book') Xem danh sách sách
