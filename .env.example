# Sao chép file này thành ".env" rồi điền giá trị thật. KHÔNG đưa file .env lên GitHub / gửi cho người khác.

# --- Bắt buộc ---
PORT=3000
# Địa chỉ web của ứng dụng, KHÔNG có dấu "/" ở cuối (dùng để kiểm tra Origin của form)
APP_ORIGIN=http://localhost:3000
# Chuỗi kết nối MongoDB (Atlas hoặc local)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/spk
# Chuỗi ngẫu nhiên dài từ 32 ký tự (ví dụ chạy: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=THAY_BANG_CHUOI_NGAU_NHIEN_DAI_TOI_THIEU_32_KY_TU

# --- Tài khoản admin đầu tiên (dùng cho: npm run seed:admin) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=THAY_BANG_MAT_KHAU_MANH

# --- Upload ảnh bìa sách (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gửi email xác nhận đơn hàng qua API (Gmail: dùng "Mật khẩu ứng dụng") ---
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# --- Tùy chọn ---
# Nếu lỗi "querySrv ECONNREFUSED" khi kết nối Atlas, bỏ comment dòng dưới:
# DNS_SERVERS=8.8.8.8,1.1.1.1
# Chỉ cần nếu còn dùng phần MySQL cũ (route /user):
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=bookstore_user_lab
